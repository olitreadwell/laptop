	<string>/Users/olitreadwell/Library/Logs/swap-alarm.err</string>
	<key>StandardOutPath</key>
	<string>/Users/olitreadwell/Library/Logs/swap-alarm.out</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
