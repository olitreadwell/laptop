<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>OLI_ROOT</key>
		<string>/Users/olitreadwell/oli</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/olitreadwell/bin</string>
	</dict>
	<key>Label</key>
	<string>com.oli.voice-backlog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/olitreadwell/oli/meta/bin/launchd/oli-voice-backlog</string>
		<string>-lc</string>
		<string>$HOME/oli/meta/bin/oli voice-backlog run</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/olitreadwell/oli/meta/voice-backlog/logs/run.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/olitreadwell/oli/meta/voice-backlog/logs/run.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/olitreadwell/oli</string>
</dict>
</plist>
